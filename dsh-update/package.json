{
  "name": "dsh-plugin-about",
  "version": "1.0.1",
  "description": "DSH 关于面板：设置页新增「关于」区块，显示当前版本与 npm 最新发布版本，附一键升级按钮（宿主端执行 npm install -g）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7"
  }
}
